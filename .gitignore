# Ignore Cargo build target directories anywhere in the repository
**/target/
target/

# Ignore Cargo lockfiles in any subdirectory (if you do not want Cargo lockfiles tracked)
**/Cargo.lock
Cargo.lock

# Backup files generated by rustfmt anywhere
**/*.rs.bk
*.rs.bk

# MSVC Windows build artifacts
**/*.pdb
*.pdb

# Environment variables & local secrets
**/.env
**/.env.*
!**/.env.example

# OS-generated files
.DS_Store
Thumbs.db

# IDE / Editor configurations
.idea/
.vscode/
*.swp
*.swo
